{
  "name": "dashboard-admin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "concurrently -n server,dev -c blue,green \"npm run server\" \"npm run dev\"",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "jest --runInBand",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "server": "cd server && npm run start",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.node.json",
    "test:server": "npm --prefix server test",
    "lint": "eslint ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.13.3",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.1.0",
    "eslint": "^10.13.0",
    "globals": "^16.5.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-jest-mock-import-meta": "^1.3.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.0"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "tmp": "^0.2.5"
  }
}
